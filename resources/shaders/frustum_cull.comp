#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout: require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "types.h"
#include "util.h"

layout(std430, set = 0, binding = 0) BUFFER {
    FrameGlobal frame_global;
};

layout(push_constant) uniform PushConstants {
    uint16_t object_index;
    uint16_t meshlet_count;
};

void main() {
    uint16_t meshlet_index = uint16_t(gl_GlobalInvocationID.x);

    // Filter invalid invocation ids.
    if (meshlet_index >= meshlet_count) return;

    // 
    ObjectInstance object = frame_global.object_buffer.data[object_index];
    Meshlet meshlet = object.meshlet_buffer.data[meshlet_index];
    #define VISIBILITY (object.visibility_buffer.data[meshlet_index])
    #define PREVIOUS_VISIBILITY (object.previous_visibility_buffer.data[meshlet_index])
    
    // Frustum cull (view-space sphere test).
    vec3 center_ws = object.position + object.scale * rotate_quat(meshlet.center, object.orientation);
    vec4 center = frame_global.view * vec4(center_ws, 1.0);
    float radius = object.scale * meshlet.radius;

    float znear = -0.1;
    bool visible_x = center.z * frame_global.frustum[1] - abs(center.x) * frame_global.frustum[0] > -radius;
    bool visible_y = center.z * frame_global.frustum[3] - abs(center.y) * frame_global.frustum[2] > -radius;
    bool visible_z = center.z - radius < znear;
    if (!(visible_x && visible_y && visible_z)) {
        VISIBILITY = 0u;
        return;
    };

    // Backface cone cull (world space, meshoptimizer perspective formula).
    if (meshlet.cone_cutoff < 1.0) {
        vec3 cone_apex = object.position + object.scale * rotate_quat(meshlet.cone_apex, object.orientation);
        vec3 cone_axis = normalize(rotate_quat(meshlet.cone_axis, object.orientation));
        if (dot(normalize(cone_apex - frame_global.camera_position), cone_axis) >= meshlet.cone_cutoff) {
            VISIBILITY = 0u;
            return;
        }
    }

    /* At this point, the meshlet is within the frustum. */

    // Every frustum-visible meshlet participates in the speculative visibility pass.
    const uint candidate_index = atomicAdd(frame_global.frustum_passing_meshlet_buffer.len, 1);
    frame_global.frustum_passing_meshlet_buffer.data[candidate_index] = MeshletLookup(object_index, meshlet_index);
    if ((candidate_index & 63) == 0) {
        atomicAdd(frame_global.occlusion_dispatch.x, 1);
    }

    // If it wasn't visible N frames ago, defer the draw to the late pass.
    if (PREVIOUS_VISIBILITY == 0u) {
        return;
    }

    // ... otherwise, append as a draw command.
    uint pad0, pad1;
    pack(pad0, pad1, object_index, meshlet_index);
    const uint i = atomicAdd(frame_global.draw_cmd_buffer.len, 1);
    frame_global.draw_cmd_buffer.data[i] = make_draw_cmd(meshlet, object.scene_index_offset, pad0, pad1);
}
