#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout (set = 0, binding = 0) uniform sampler2D src_views[];
layout (set = 0, binding = 1, r32f) uniform writeonly image2D dst_views[];

void main() {
    uint view = gl_GlobalInvocationID.z;
    ivec2 dst_xy = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dst_size = imageSize(dst_views[view]);

    if (any(greaterThanEqual(dst_xy, dst_size))) {
        return;
    }

    ivec2 src_size = textureSize(src_views[view], 0);
    vec2 src_uv = (vec2(dst_xy) * 2.0 + vec2(1.0)) / vec2(src_size);

    // The HZB sampler uses linear filtering with MIN reduction. Sampling the
    // center of the source footprint reduces the same 2x2 texels that the old
    // explicit texelFetch path reduced. Reverse-Z stores the minimum depth,
    // which is the farthest visible depth in the footprint.
    float reduced = textureLod(src_views[view], src_uv, 0.0).r;
    imageStore(dst_views[view], dst_xy, vec4(reduced, 0.0, 0.0, 0.0));
}
