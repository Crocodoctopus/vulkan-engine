#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "types.h"

layout(std430, set = 1, binding = 0) UNIFORM {
    FrameGlobal frame_global;
};

layout(r32ui, set = 1, binding = 1) readonly uniform uimage2D overdraw_counts;

layout(rgba8, set = 1, binding = 2) uniform writeonly image2D swapchain_image;

vec3 heatmap_color(float t) {
    if (t < 0.25) {
        return mix(vec3(0.0, 0.0, 1.0), vec3(0.0, 1.0, 0.0), t / 0.25);
    }
    if (t < 0.5) {
        return mix(vec3(0.0, 1.0, 0.0), vec3(1.0, 0.0, 0.0), (t - 0.25) / 0.25);
    }
    if (t < 0.75) {
        return mix(vec3(1.0, 0.0, 0.0), vec3(1.0, 0.0, 1.0), (t - 0.5) / 0.25);
    }
    return mix(vec3(1.0, 0.0, 1.0), vec3(1.0), (t - 0.75) / 0.25);
}

void main() {
    uvec2 screen = uvec2(frame_global.screen_info.xy);
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= screen.x || p.y >= screen.y) {
        return;
    }

    float count = float(imageLoad(overdraw_counts, ivec2(p)).r);
    float t = clamp(log2(count + 1.0) / 6.0, 0.0, 1.0);
    vec3 color = heatmap_color(t);

    imageStore(swapchain_image, ivec2(p), vec4(color, 1.0));
}
