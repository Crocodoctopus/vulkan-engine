#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout: require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "types.h"

layout (std430, set = 0, binding = 0) uniform SceneGlobal {
    mat4 pv;
    mat4 proj;
    mat4 view;

    vec3 camera_position;
    vec3 camera_direction;
    vec3 light_position;
    vec4 light_color;
};

layout (std430, set = 1, binding = 0) uniform MeshletCullGlobal {
    vec4 frustum;

    DrawCountBuffer draw_count_buffer;
    MeshletBuffer meshlet_buffer;
    DrawCmdBuffer draw_cmd_buffer;
    InstanceBuffer instance_buffer;
    ObjectBuffer object_buffer;

    uint instances;
};

vec3 rotate_quat(vec3 v, vec4 q) {
    return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
}

void main() {
    // Filter invalid invocation ids.
    if (gl_GlobalInvocationID.x >= instances) return;

    //
    MeshletData meshlet = meshlet_buffer.data[gl_GlobalInvocationID.x];
    Object object = object_buffer.data[meshlet.object_id];

    // Frustum cull (view-space sphere test).
    vec3 center_ws = object.position + object.scale * rotate_quat(meshlet.center, object.orientation);
    vec4 center = view * vec4(center_ws, 1.0);
    float radius = object.scale * meshlet.radius;

    float znear = -10.0;
    float zfar = 0.0;
    bool visible_x = center.z * frustum[1] - abs(center.x) * frustum[0] > -radius;
    bool visible_y = center.z * frustum[3] - abs(center.y) * frustum[2] > -radius;
    bool visible_z = center.z + radius > znear && center.z - radius < zfar;
    if (!(visible_x && visible_y && visible_z)) return;

    // Backface cone cull (world space, meshoptimizer perspective formula).
    if (meshlet.cone_cutoff < 1.0) {
        vec3 cone_apex = object.position + object.scale * rotate_quat(meshlet.cone_apex, object.orientation);
        vec3 cone_axis = normalize(rotate_quat(meshlet.cone_axis, object.orientation));
        if (dot(normalize(cone_apex - camera_position), cone_axis) >= meshlet.cone_cutoff) return;
    }

    // Append draw command.
    VkDrawIndexedIndirectCommand cmd;
    cmd.index_count = meshlet.index_count;
    cmd.first_index = meshlet.first_index;
    cmd.instance_count = 1;
    cmd.vertex_offset = 0;
    cmd.first_instance = gl_GlobalInvocationID.x;

    const uint i = atomicAdd(draw_count_buffer.counter, 1);
    draw_cmd_buffer.data[i] = cmd;
    instance_buffer.data[i].object_id = meshlet.object_id;
}
