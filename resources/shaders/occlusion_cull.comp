#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout: require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_nonuniform_qualifier : require

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "types.h"
#include "util.h"

layout (set = 0, binding = 0) uniform sampler2D hzb_views[];

layout(std430, set = 1, binding = 0) BUFFER {
    FrameGlobal frame_global;
};

const float NEAR_PLANE = 0.1;
const float DEPTH_BIAS = 0.000001;

bool box_occluded(Meshlet meshlet, ObjectInstance object) {
    vec3 corners[8] = vec3[8](
        vec3(meshlet.aabb_min.x, meshlet.aabb_min.y, meshlet.aabb_min.z),
        vec3(meshlet.aabb_max.x, meshlet.aabb_min.y, meshlet.aabb_min.z),
        vec3(meshlet.aabb_min.x, meshlet.aabb_max.y, meshlet.aabb_min.z),
        vec3(meshlet.aabb_max.x, meshlet.aabb_max.y, meshlet.aabb_min.z),
        vec3(meshlet.aabb_min.x, meshlet.aabb_min.y, meshlet.aabb_max.z),
        vec3(meshlet.aabb_max.x, meshlet.aabb_min.y, meshlet.aabb_max.z),
        vec3(meshlet.aabb_min.x, meshlet.aabb_max.y, meshlet.aabb_max.z),
        vec3(meshlet.aabb_max.x, meshlet.aabb_max.y, meshlet.aabb_max.z)
    );

    // Anything touching the near plane is kept visible; projection bounds become
    // unstable there and conservative culling should favor false negatives.
    vec2 ndc_min = vec2( 1e30);
    vec2 ndc_max = vec2(-1e30);
    float nearest_box_depth = 0.0;

    for (uint i = 0; i < 8; i++) {
        vec3 corner_ws = object.position + object.scale * rotate_quat(corners[i], object.orientation);
        vec3 corner_vs = (frame_global.view * vec4(corner_ws, 1.0)).xyz;
        if (corner_vs.z >= -NEAR_PLANE) {
            return false;
        }

        vec4 clip = frame_global.proj * vec4(corner_vs, 1.0);
        if (clip.w <= 0.0) {
            return false;
        }

        vec3 ndc = clip.xyz / clip.w;
        nearest_box_depth = max(nearest_box_depth, clamp(ndc.z, 0.0, 1.0));
        ndc_min = min(ndc_min, ndc.xy);
        ndc_max = max(ndc_max, ndc.xy);
    }

    vec2 uv_min = ndc_min * 0.5 + 0.5;
    vec2 uv_max = ndc_max * 0.5 + 0.5;

    if (uv_max.x <= 0.0 || uv_max.y <= 0.0 || uv_min.x >= 1.0 || uv_min.y >= 1.0) {
        return false;
    }

    uv_min = clamp(uv_min, vec2(0.0), vec2(1.0));
    uv_max = clamp(uv_max, vec2(0.0), vec2(1.0));

    // Query bounds should be expressed in actual screen coverage, not the padded HZB allocation.
    ivec2 base_size = ivec2((frame_global.screen_info.xy + vec2(1.0)) * 0.5);
    vec2 base_size_f = vec2(base_size);
    ivec2 base_min = clamp(ivec2(floor(uv_min * base_size_f)), ivec2(0), base_size - ivec2(1));
    ivec2 base_max = clamp(ivec2(ceil (uv_max * base_size_f)) - ivec2(1), ivec2(0), base_size - ivec2(1));
    base_max = max(base_max, base_min);

    int mip_count = int(floor(log2(float(max(base_size.x, base_size.y))))) + 1;
    int mip = 0;
    for (; mip < mip_count - 1; mip++) {
        int scale = 1 << mip;
        ivec2 mip_min_probe = base_min / scale;
        ivec2 mip_max_probe = base_max / scale;
        ivec2 mip_extent_probe = mip_max_probe - mip_min_probe + ivec2(1);
        if (mip_extent_probe.x <= 2 && mip_extent_probe.y <= 2) {
            break;
        }
    }

    int view_index = 1 + mip;
    int mip_scale = 1 << mip;
    ivec2 mip_size = textureSize(hzb_views[nonuniformEXT(view_index)], 0);
    ivec2 mip_min = clamp(base_min / mip_scale, ivec2(0), mip_size - ivec2(1));
    ivec2 mip_max = clamp(base_max / mip_scale, ivec2(0), mip_size - ivec2(1));

    float z00 = texelFetch(hzb_views[nonuniformEXT(view_index)], ivec2(mip_min.x, mip_min.y), 0).r;
    float z10 = texelFetch(hzb_views[nonuniformEXT(view_index)], ivec2(mip_max.x, mip_min.y), 0).r;
    float z01 = texelFetch(hzb_views[nonuniformEXT(view_index)], ivec2(mip_min.x, mip_max.y), 0).r;
    float z11 = texelFetch(hzb_views[nonuniformEXT(view_index)], ivec2(mip_max.x, mip_max.y), 0).r;
    float farthest_occluder_depth = min(min(z00, z10), min(z01, z11));

    // Reverse-Z uses larger values for closer geometry. The meshlet box is
    // occluded only if every depth represented by the sampled HZB texels is
    // closer than the nearest possible depth of the box.
    return farthest_occluder_depth > nearest_box_depth + DEPTH_BIAS;
}

void main() {
    uint candidate_index = gl_GlobalInvocationID.x;

    uint candidate_count = frame_global.frustum_passing_meshlet_buffer.len;
    if (candidate_index >= candidate_count) {
        return;
    }

    MeshletLookup lookup = frame_global.frustum_passing_meshlet_buffer.data[candidate_index];
    ObjectInstance object = frame_global.object_buffer.data[lookup.object_index];
    Meshlet meshlet = object.meshlet_buffer.data[lookup.meshlet_index];
    #define VISIBILITY (object.visibility_buffer.data[lookup.meshlet_index])
    #define PREVIOUS_VISIBILITY (object.previous_visibility_buffer.data[lookup.meshlet_index])

    bool was_visible = PREVIOUS_VISIBILITY != 0u;
    bool visible = !box_occluded(meshlet, object);
    VISIBILITY = uint(visible);

    if (visible && !was_visible) {
        uint pad0, pad1;
        pack(pad0, pad1, lookup.object_index, lookup.meshlet_index);
        const uint draw_index = atomicAdd(frame_global.draw_cmd_buffer.len, 1);
        frame_global.draw_cmd_buffer.data[draw_index] = make_draw_cmd(meshlet, object.scene_index_offset, pad0, pad1);
    }
}
